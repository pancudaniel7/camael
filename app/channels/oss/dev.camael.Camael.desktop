[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Camael
GenericName=TerminalEmulator

Exec=camael %U
StartupWMClass=dev.camael.Camael

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.camael.Camael

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for camael:// URLs.
MimeType=x-scheme-handler/camael;
